digraph busqueda {
  graph [rankdir=TB, ordering=out];
  node [shape=box, style="rounded,filled", fontname="DejaVu Sans"];
  edge [fontname="DejaVu Sans", fontsize=10];
  n0 [label="camino(X,d,Y)", fillcolor="#edf3ff"];
  n1 [label="arco(X,d)", fillcolor="#edf3ff"];
  n2 [label="EXITO: objetivo vacio\nX=a, Y=[a,d]", fillcolor="#daf5e7"];
  n3 [label="EXITO: objetivo vacio\nX=c, Y=[c,d]", fillcolor="#daf5e7"];
  n4 [label="arco(X,Z1),\ncamino(Z1,d,R1)", fillcolor="#edf3ff"];
  n5 [label="camino(b,d,R1)", fillcolor="#edf3ff"];
  n6 [label="arco(b,d)", fillcolor="#edf3ff"];
  n7 [label="FALLO", fillcolor="#ffe4e6"];
