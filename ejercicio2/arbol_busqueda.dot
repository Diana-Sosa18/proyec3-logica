  n10 [label="camino(c,d,R1)", fillcolor="#edf3ff"];
  n11 [label="arco(c,d)", fillcolor="#edf3ff"];
  n12 [label="EXITO: objetivo vacio\nX=a, Y=[a,c,d]", fillcolor="#daf5e7"];
  n13 [label="arco(c,Z2),\ncamino(Z2,d,R2)", fillcolor="#edf3ff"];
  n14 [label="camino(d,d,R2)", fillcolor="#edf3ff"];
