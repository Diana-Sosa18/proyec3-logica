  n21 [label="FALLO", fillcolor="#ffe4e6"];
  n22 [label="arco(d,Z2),\ncamino(Z2,d,R2)", fillcolor="#edf3ff"];
  n23 [label="FALLO", fillcolor="#ffe4e6"];
  n24 [label="camino(d,d,R1)", fillcolor="#edf3ff"];
  n25 [label="arco(d,d)", fillcolor="#edf3ff"];
  n26 [label="FALLO", fillcolor="#ffe4e6"];
