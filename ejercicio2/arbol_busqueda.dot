  n0 -> n1 [label="base: Y=[X,d]"];
  n1 -> n2 [label="X=a"];
  n1 -> n3 [label="X=c"];
  n0 -> n4 [label="rec.: Y=[X|R1]"];
  n4 -> n5 [label="X=a, Z1=b"];
  n5 -> n6 [label="base: R1=[b,d]"];
  n6 -> n7 [label="sin hecho compatible"];
  n5 -> n8 [label="rec.: R1=[b|R2]"];
  n8 -> n9 [label="sin hecho compatible"];
  n4 -> n10 [label="X=a, Z1=c"];
  n10 -> n11 [label="base: R1=[c,d]"];
  n11 -> n12 [label="hecho arco(c,d)"];
  n10 -> n13 [label="rec.: R1=[c|R2]"];
  n13 -> n14 [label="Z2=d"];
  n14 -> n15 [label="base: R2=[d,d]"];
  n15 -> n16 [label="sin hecho compatible"];
  n14 -> n17 [label="rec.: R2=[d|R3]"];
  n17 -> n18 [label="sin hecho compatible"];
  n4 -> n19 [label="X=a, Z1=d"];
  n19 -> n20 [label="base: R1=[d,d]"];
  n20 -> n21 [label="sin hecho compatible"];
